{
  "name": "archive-ocellus-trainer",
  "version": "0.0.1",
  "private": true,
  "description": "A free practice simulator for phase 4 of the Ocellus fight in The Fractured Archive.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julian-Dasilva/ArchiveOcellusTrainer.git"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production && tsx src/cacheHeaders/check.ts dist",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit --moduleResolution bundler && node scripts/check-types.mjs",
    "typecheck:tsc": "tsc --noEmit && node scripts/check-types.mjs",
    "assets": "bash scripts/assets.sh",
    "item-icons": "tsx src/itemIcons/build.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.163.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "copy-webpack-plugin": "^9.0.1",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "30.1.2",
    "ts-loader": "^9.5.1",
    "tsx": "4.23.13",
    "typescript": "^4.9.5",
    "vitest": "5.0.3",
    "webpack": "^5.91.0",
    "webpack-cli": "^4.9.2",
    "webpack-dev-server": "^3.11.3"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.163.0"
  }
}
